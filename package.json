{
  "name": "fabrica",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "FABRICA_DEV=1 tsx server/main.ts",
    "build": "next build",
    "start": "node --import tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=2 'test/unit/*.test.ts' 'test/integration/*.test.ts'",
    "test:e2e": "node --import tsx test/e2e/run.ts",
    "test:validator": "node --import tsx scripts/validator-check.ts",
    "load": "node --import tsx scripts/load.ts",
    "shots": "node scripts/shots.mjs",
    "admin": "node --import tsx scripts/admin.ts",
    "record": "node --import tsx scripts/record-tools.ts",
    "real-test": "node --import tsx scripts/real-test.ts"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "buffer": "6.0.3",
    "next": "16.4.4",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
